PORT=3000

# Secreto opcional para proteger el endpoint /api/ping-all frente a llamadas externas no autorizadas
CRON_SECRET=tu_secreto_super_seguro

# Expresión cron para ejecución automática interna (por defecto: 0 0 * * * = diariamente a medianoche)
CRON_SCHEDULE=0 0 * * *

# Proyectos opcionales en formato JSON (útil para serverless o GitHub Secrets sin guardar archivos)
# SUPABASE_PROJECTS='[{"name":"Mi App 1","url":"https://xyz.supabase.co","key":"eyJhbG...","target":"rest"}]'
